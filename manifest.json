{
  "manifest_version": 3,
  "name": "QuietBlock — Anti-adblock helper",
  "short_name": "QuietBlock",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "A per-site, best-effort helper for common DOM-based adblock checks. Keep your existing adblocker enabled.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "downloads"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "QuietBlock",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
